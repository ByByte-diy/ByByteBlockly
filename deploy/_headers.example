# Netlify: rename to dist/web/_headers after build (or merge with existing _headers).
# Same rules as deploy/static-headers — see deploy/README.md

/assets/cache-manifest.json
  Cache-Control: public, max-age=60, stale-while-revalidate=300

/assets/wasm/*/wasm-catalog.json
  Cache-Control: public, max-age=300

/assets/wasm/*/*
  Cache-Control: public, max-age=31536000, immutable
