# Recommended Cache-Control for static hosting (Netlify _headers, nginx snippets, etc.)
#
# cache-manifest.json must stay fresh so clients detect new WASM bundle versions
# even when the SPA shell is cached aggressively.

/assets/cache-manifest.json
  Cache-Control: public, max-age=60, stale-while-revalidate=300

/assets/wasm/*/wasm-catalog.json
  Cache-Control: public, max-age=300

/assets/wasm/*/*
  Cache-Control: public, max-age=31536000, immutable
