{
  "wave": "W1",
  "description": "Otto / Ninja core: EEPROM wrapper + Otto + Oscillator + matrix",
  "libraries": [
    {
      "id": "EEPROM",
      "headers": [
        {
          "from": "src/wasm-avr/libraries/EEPROM.h",
          "virtual": "/arduino/libraries/EEPROM/src/EEPROM.h"
        }
      ],
      "includePaths": ["/arduino/libraries/EEPROM/src"],
      "sources": [
        {
          "from": "src/wasm-avr/eeprom-avr.cpp",
          "object": "/objects/lib_eeprom_avr.o"
        }
      ]
    },
    {
      "id": "Otto",
      "root": "src/wasm-avr/libraries/Otto",
      "headers": [
        { "from": "Otto.h", "virtual": "/libraries/Otto/Otto.h" },
        { "from": "Oscillator.h", "virtual": "/libraries/Otto/Oscillator.h" },
        { "from": "Otto_gestures.h", "virtual": "/libraries/Otto/Otto_gestures.h" },
        { "from": "Otto_mouths.h", "virtual": "/libraries/Otto/Otto_mouths.h" },
        { "from": "Otto_sounds.h", "virtual": "/libraries/Otto/Otto_sounds.h" },
        { "from": "Otto_matrix.h", "virtual": "/libraries/Otto/Otto_matrix.h" }
      ],
      "includePaths": ["/libraries/Otto"],
      "sources": [
        { "from": "Oscillator.cpp", "object": "/objects/lib_Oscillator.o" },
        { "from": "Otto_matrix.cpp", "object": "/objects/lib_Otto_matrix.o" },
        { "from": "Otto.cpp", "object": "/objects/lib_Otto.o" }
      ]
    }
  ]
}
